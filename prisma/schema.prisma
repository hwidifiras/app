// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MemberStatus {
  ACTIVE
  ARCHIVED
}

enum MemberType {
  ADULT
  KID
  NOT_SPECIFIED
}

enum Gender {
  MALE
  FEMALE
  NOT_SPECIFIED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum GroupMemberStatus {
  ACTIVE
  INACTIVE
}

enum GroupType {
  KIDS
  ADULTS
  MIXED
}

enum GroupGenderPolicy {
  MALE_ONLY
  FEMALE_ONLY
  MIXED
}

enum SessionStatus {
  PLANNED
  RESCHEDULED
  CANCELLED
  COMPLETED
}

enum SubscriptionStatus {
  DRAFT
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PlanActivationPolicy {
  FIXED_DATE
  FIRST_USE
}

enum SubscriptionPauseEntryType {
  PAUSE
  RESUME
}

enum EntitlementAdjustmentKind {
  UNITS
  EXPIRY
  ACTIVATION
  REPLACEMENT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  OVERRIDE
}

enum PaymentEntryType {
  PAYMENT
  CORRECTION
  REVERSAL
}

enum ReceiptStatus {
  ISSUED
  VOIDED
}

enum UserRole {
  ADMIN
  STAFF
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum HouseholdRelationship {
  PARENT
  CHILD
  SIBLING
  GUARDIAN
  OTHER
}

enum OfferKind {
  FAMILY_BUNDLE
  SECOND_DISCIPLINE
  PERCENT_OFF
  FIXED_OFF
}

enum OfferPlanScope {
  ALL
  CLASS
  GYM
  MIXED
}

enum PlanKind {
  CLASS
  GYM
  MIXED
}

enum EntitlementType {
  CLASS_SESSIONS
  GYM_ACCESS
}

enum GymAccessMode {
  UNLIMITED
  VISIT_QUOTA
}

enum GymVisitEntryType {
  CHECK_IN
  REVERSAL
}

enum GymAccessAttemptOutcome {
  DENIED
  EXCEPTIONAL_ALLOWED
}

enum TenantModuleKey {
  CLASS_MANAGEMENT
  GYM_ACCESS
}

enum TenantModuleStatus {
  ENABLED
  DISABLED
}

model Tenant {
  id                       String                    @id @default(cuid())
  slug                     String                    @unique
  name                     String
  status                   TenantStatus              @default(ACTIVE)
  rootDomainAlias          String?                   @unique
  users                    User[]
  userPermissions          UserPermission[]
  passwordResetTokens      PasswordResetToken[]
  idempotencyRecords       IdempotencyRecord[]
  notificationReads        NotificationRead[]
  clubSettings             ClubSettings?
  members                  Member[]
  households               Household[]
  householdMembers         HouseholdMember[]
  sports                   Sport[]
  coaches                  Coach[]
  coachQualifications      CoachSportQualification[]
  groups                   Group[]
  groupMembers             GroupMember[]
  groupSchedules           GroupSchedule[]
  scheduleTemplates        ScheduleTemplate[]
  scheduleTemplateSlots    ScheduleTemplateSlot[]
  sessions                 Session[]
  subscriptionPlans        SubscriptionPlan[]
  memberSubscriptions      MemberSubscription[]
  payments                 Payment[]
  receipts                 Receipt[]
  offers                   Offer[]
  offerApplications        OfferApplication[]
  attendances              Attendance[]
  auditLogs                AuditLog[]
  modules                  TenantModule[]
  planEntitlements         PlanEntitlement[]
  subscriptionEntitlements SubscriptionEntitlement[]
  gymVisits                GymVisit[]
  memberAccessCredentials  MemberAccessCredential[]
  gymAccessAttempts        GymAccessAttempt[]
  subscriptionPauses       SubscriptionPause[]
  entitlementAdjustments   EntitlementAdjustment[]
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
}

model User {
  id                      String                   @id @default(cuid())
  tenantId                String?
  tenant                  Tenant?                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  coachId                 String?                  @unique
  coach                   Coach?                   @relation("CoachUserAccount", fields: [coachId], references: [id], onDelete: SetNull)
  email                   String
  name                    String
  passwordHash            String
  role                    UserRole                 @default(STAFF)
  isActive                Boolean                  @default(true)
  permissions             UserPermission[]
  notificationReads       NotificationRead[]
  passwordResetTokens     PasswordResetToken[]
  gymVisitsChecked        GymVisit[]               @relation("GymVisitCheckedBy")
  gymCredentialsIssued    MemberAccessCredential[] @relation("GymCredentialIssuedBy")
  gymCredentialsRevoked   MemberAccessCredential[] @relation("GymCredentialRevokedBy")
  gymAccessAttempts       GymAccessAttempt[]       @relation("GymAccessAttemptActor")
  subscriptionPauseEvents SubscriptionPause[]      @relation("SubscriptionPauseActor")
  entitlementAdjustments  EntitlementAdjustment[]  @relation("EntitlementAdjustmentActor")
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  @@unique([tenantId, email])
  @@index([tenantId])
}

model UserPermission {
  id        String   @id @default(cuid())
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  createdAt DateTime @default(now())

  @@unique([tenantId, userId, key])
  @@index([tenantId])
  @@index([key])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tenantId  String?
  tenant    Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([tenantId, tokenHash])
  @@index([tenantId])
  @@index([userId])
  @@index([expiresAt])
}

model IdempotencyRecord {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  scope          String
  key            String
  requestHash    String
  responseStatus Int
  responseBody   String
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  @@unique([tenantId, scope, key])
  @@index([tenantId])
  @@index([tenantId, expiresAt])
  @@index([expiresAt])
}

model NotificationRead {
  id              String   @id @default(cuid())
  tenantId        String?
  tenant          Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  notificationKey String
  readAt          DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tenantId, userId, notificationKey])
  @@index([tenantId])
  @@index([userId, readAt])
}

model ClubSettings {
  id                                    String      @id @default(cuid())
  tenantId                              String?     @unique
  tenant                                Tenant?     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clubName                              String      @default("")
  clubLogoUrl                           String      @default("")
  clubAddress                           String      @default("")
  clubPhone                             String      @default("")
  receiptLegalName                      String      @default("")
  receiptTaxId                          String      @default("")
  allowCheckInWithPartialPayment        Boolean     @default(true)
  allowCheckInWithoutSubscription       Boolean     @default(false)
  absentConsumesSession                 Boolean     @default(true)
  allowSameRoomConcurrentGroups         Boolean     @default(false)
  allowCoachConcurrentSameRoomQualified Boolean     @default(false)
  allowPublicRegister                   Boolean     @default(false)
  workingDays                           DayOfWeek[] @default([MONDAY, TUESDAY, WEDNESDAY, THURSDAY, FRIDAY, SATURDAY])
  maxStaffDiscountPercent               Int         @default(30)
  debtAlertThresholdCents               Int         @default(0)
  dashboardDefaultMode                  String      @default("AUTO")
  dashboardShowTodaySessions            Boolean     @default(true)
  dashboardShowCashToday                Boolean     @default(true)
  dashboardShowDataConfidence           Boolean     @default(true)
  dashboardShowCashTrend                Boolean     @default(true)
  dashboardShowMembersOverview          Boolean     @default(true)
  dashboardShowCommercialInsights       Boolean     @default(true)
  dashboardShowDetailedDebts            Boolean     @default(true)
  dashboardShowGymOverview              Boolean     @default(true)
  gymAllowCheckInWithPartialPayment     Boolean     @default(true)
  gymDuplicateScanWindowMinutes         Int         @default(2)
  gymDailyVisitLimit                    Int?
  gymAllowExceptionalAccess             Boolean     @default(true)
  gymEnforceOpeningHours                Boolean     @default(false)
  gymOpeningHours                       Json        @default("[]")
  receiptPrefix                         String      @default("WD")
  nextReceiptSequence                   Int         @default(1)
  receiptFooter                         String      @default("")
  receiptEmailDefault                   Boolean     @default(false)
  receiptPrintDefault                   Boolean     @default(true)
  updatedAt                             DateTime    @updatedAt
}

model Member {
  id                String                   @id @default(cuid())
  tenantId          String?
  tenant            Tenant?                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  firstName         String
  lastName          String
  phone             String
  email             String?
  memberType        MemberType               @default(NOT_SPECIFIED)
  gender            Gender                   @default(NOT_SPECIFIED)
  birthDate         DateTime?
  address           String?
  parentName        String?
  parentPhone       String?
  parentAddress     String?
  status            MemberStatus             @default(ACTIVE)
  groups            GroupMember[]
  subscriptions     MemberSubscription[]
  attendances       Attendance[]
  gymVisits         GymVisit[]
  accessCredentials MemberAccessCredential[]
  gymAccessAttempts GymAccessAttempt[]
  householdLink     HouseholdMember?
  joinedAt          DateTime                 @default(now())
  archivedAt        DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@unique([tenantId, phone])
  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([tenantId, status, createdAt])
}

model Household {
  id        String            @id @default(cuid())
  tenantId  String?
  tenant    Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  label     String?
  members   HouseholdMember[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([tenantId])
}

model HouseholdMember {
  id           String                @id @default(cuid())
  tenantId     String?
  tenant       Tenant?               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  householdId  String
  household    Household             @relation(fields: [householdId], references: [id], onDelete: Cascade)
  memberId     String                @unique
  member       Member                @relation(fields: [memberId], references: [id], onDelete: Cascade)
  relationship HouseholdRelationship @default(OTHER)
  createdAt    DateTime              @default(now())

  @@unique([tenantId, memberId])
  @@unique([tenantId, householdId, memberId])
  @@index([tenantId])
}

model Sport {
  id                       String                    @id @default(cuid())
  tenantId                 String?
  tenant                   Tenant?                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                     String
  description              String?
  isActive                 Boolean                   @default(true)
  coaches                  Coach[]
  coachQualifications      CoachSportQualification[]
  groups                   Group[]
  subscriptionPlans        SubscriptionPlan[]
  memberSubscriptions      MemberSubscription[]
  offers                   Offer[]
  planEntitlements         PlanEntitlement[]
  subscriptionEntitlements SubscriptionEntitlement[]
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Coach {
  id             String                    @id @default(cuid())
  tenantId       String?
  tenant         Tenant?                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  firstName      String
  lastName       String
  phone          String
  email          String?
  birthDate      DateTime?
  isActive       Boolean                   @default(true)
  sportId        String?
  sport          Sport?                    @relation(fields: [sportId], references: [id], onDelete: SetNull)
  qualifications CoachSportQualification[]
  groups         Group[]
  sessions       Session[]
  userAccount    User?                     @relation("CoachUserAccount")
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@unique([tenantId, phone])
  @@index([tenantId])
}

model CoachSportQualification {
  id        String   @id @default(cuid())
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  coachId   String
  coach     Coach    @relation(fields: [coachId], references: [id], onDelete: Cascade)
  sportId   String
  sport     Sport    @relation(fields: [sportId], references: [id], onDelete: Restrict)
  isPrimary Boolean  @default(false)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, coachId, sportId])
  @@index([tenantId])
  @@index([sportId])
}

model Group {
  id           String            @id @default(cuid())
  tenantId     String?
  tenant       Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  groupType    GroupType         @default(ADULTS)
  genderPolicy GroupGenderPolicy @default(MIXED)
  sportId      String
  sport        Sport             @relation(fields: [sportId], references: [id], onDelete: Restrict)
  coachId      String
  coach        Coach             @relation(fields: [coachId], references: [id], onDelete: Restrict)
  capacity     Int
  room         String?
  isActive     Boolean           @default(true)
  members      GroupMember[]
  schedules    GroupSchedule[]
  sessions     Session[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([tenantId])
  @@index([tenantId, sportId, isActive])
}

model GroupMember {
  id        String            @id @default(cuid())
  tenantId  String?
  tenant    Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  groupId   String
  memberId  String
  group     Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  member    Member            @relation(fields: [memberId], references: [id], onDelete: Restrict)
  startDate DateTime
  endDate   DateTime?
  status    GroupMemberStatus @default(ACTIVE)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([tenantId, groupId, memberId])
  @@index([tenantId])
  @@index([tenantId, memberId, status])
}

model GroupSchedule {
  id              String    @id @default(cuid())
  tenantId        String?
  tenant          Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  groupId         String
  group           Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  dayOfWeek       DayOfWeek
  startTime       String
  durationMinutes Int
  effectiveFrom   DateTime  @default(now())
  effectiveTo     DateTime?
  sessions        Session[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([tenantId])
}

model ScheduleTemplate {
  id          String                 @id @default(cuid())
  tenantId    String?
  tenant      Tenant?                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String                 @default("")
  isActive    Boolean                @default(true)
  slots       ScheduleTemplateSlot[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
}

model ScheduleTemplateSlot {
  id              String           @id @default(cuid())
  tenantId        String?
  tenant          Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  templateId      String
  template        ScheduleTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  dayOfWeek       DayOfWeek
  startTime       String
  durationMinutes Int
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([tenantId, templateId, dayOfWeek, startTime])
  @@index([tenantId])
  @@index([templateId])
}

model Session {
  id                  String         @id @default(cuid())
  tenantId            String?
  tenant              Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  groupId             String
  group               Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  scheduleId          String?
  schedule            GroupSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  sessionDate         DateTime
  startTime           String
  endTime             String
  coachId             String?
  coach               Coach?         @relation(fields: [coachId], references: [id], onDelete: SetNull)
  room                String
  status              SessionStatus  @default(PLANNED)
  exceptionReason     String?
  postponedTo         DateTime?
  postponementReason  String?
  postponementDetails String?
  attendances         Attendance[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@unique([tenantId, groupId, sessionDate, startTime])
  @@index([tenantId])
  @@index([tenantId, sessionDate, status])
}

model SubscriptionPlan {
  id                   String               @id @default(cuid())
  tenantId             String?
  tenant               Tenant?              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                 String
  description          String?
  price                Int
  totalSessions        Int
  sessionsPerWeek      Int?
  validityDays         Int
  isActive             Boolean              @default(true)
  planKind             PlanKind             @default(CLASS)
  activationPolicy     PlanActivationPolicy @default(FIXED_DATE)
  activationWindowDays Int                  @default(90)
  freezeAllowanceCount Int                  @default(0)
  freezeMaxTotalDays   Int                  @default(0)
  sportId              String?
  sport                Sport?               @relation(fields: [sportId], references: [id], onDelete: Restrict)
  entitlements         PlanEntitlement[]
  subscriptions        MemberSubscription[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
}

model MemberSubscription {
  id                     String                    @id @default(cuid())
  tenantId               String?
  tenant                 Tenant?                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberId               String
  member                 Member                    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  planId                 String
  plan                   SubscriptionPlan          @relation(fields: [planId], references: [id], onDelete: Restrict)
  sportId                String?
  sport                  Sport?                    @relation(fields: [sportId], references: [id], onDelete: Restrict)
  startDate              DateTime
  endDate                DateTime?
  amount                 Int
  listPriceCents         Int?
  discountCents          Int                       @default(0)
  offerApplicationId     String?
  offerApplication       OfferApplication?         @relation(fields: [offerApplicationId], references: [id], onDelete: SetNull)
  offerName              String?
  remainingSessions      Int
  status                 SubscriptionStatus        @default(DRAFT)
  activationPolicy       PlanActivationPolicy      @default(FIXED_DATE)
  activationWindowDays   Int?
  activationDeadline     DateTime?
  activatedAt            DateTime?
  freezeAllowanceCount   Int                       @default(0)
  freezeMaxTotalDays     Int                       @default(0)
  renewsSubscriptionId   String?                   @unique
  renewsSubscription     MemberSubscription?       @relation("SubscriptionRenewal", fields: [renewsSubscriptionId], references: [id], onDelete: SetNull)
  renewedBySubscription  MemberSubscription?       @relation("SubscriptionRenewal")
  replacesSubscriptionId String?                   @unique
  replacesSubscription   MemberSubscription?       @relation("SubscriptionReplacement", fields: [replacesSubscriptionId], references: [id], onDelete: SetNull)
  replacedBySubscription MemberSubscription?       @relation("SubscriptionReplacement")
  payments               Payment[]
  attendances            Attendance[]
  entitlements           SubscriptionEntitlement[]
  gymVisits              GymVisit[]
  pauseEvents            SubscriptionPause[]
  entitlementAdjustments EntitlementAdjustment[]
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt

  @@index([tenantId])
  @@index([memberId, sportId, status])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, status, memberId, createdAt])
  @@index([tenantId, memberId, activationDeadline])
}

model PlanEntitlement {
  id                       String                    @id @default(cuid())
  tenantId                 String?
  tenant                   Tenant?                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId                   String
  plan                     SubscriptionPlan          @relation(fields: [planId], references: [id], onDelete: Cascade)
  type                     EntitlementType
  sportId                  String?
  sport                    Sport?                    @relation(fields: [sportId], references: [id], onDelete: Restrict)
  sessionsPerWeek          Int?
  grantedUnits             Int?
  gymAccessMode            GymAccessMode?
  sortOrder                Int                       @default(0)
  subscriptionEntitlements SubscriptionEntitlement[]
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  @@index([tenantId])
  @@index([planId])
  @@index([sportId])
}

model SubscriptionEntitlement {
  id                   String                  @id @default(cuid())
  tenantId             String?
  tenant               Tenant?                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberSubscriptionId String
  memberSubscription   MemberSubscription      @relation(fields: [memberSubscriptionId], references: [id], onDelete: Cascade)
  planEntitlementId    String?
  planEntitlement      PlanEntitlement?        @relation(fields: [planEntitlementId], references: [id], onDelete: SetNull)
  type                 EntitlementType
  sportId              String?
  sport                Sport?                  @relation(fields: [sportId], references: [id], onDelete: Restrict)
  sessionsPerWeek      Int?
  grantedUnits         Int?
  remainingUnits       Int?
  gymAccessMode        GymAccessMode?
  startDate            DateTime
  endDate              DateTime?
  attendances          Attendance[]
  gymVisits            GymVisit[]
  adjustments          EntitlementAdjustment[]
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@index([tenantId])
  @@index([memberSubscriptionId])
  @@index([planEntitlementId])
  @@index([sportId, type])
}

model SubscriptionPause {
  id                   String                     @id @default(cuid())
  tenantId             String
  tenant               Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberSubscriptionId String
  memberSubscription   MemberSubscription         @relation(fields: [memberSubscriptionId], references: [id], onDelete: Restrict)
  entryType            SubscriptionPauseEntryType
  pauseEventId         String?                    @unique
  pauseEvent           SubscriptionPause?         @relation("SubscriptionPauseResume", fields: [pauseEventId], references: [id], onDelete: Restrict)
  resumeEvent          SubscriptionPause?         @relation("SubscriptionPauseResume")
  effectiveAt          DateTime                   @default(now())
  durationSeconds      Int?
  reason               String
  createdById          String?
  createdBy            User?                      @relation("SubscriptionPauseActor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt            DateTime                   @default(now())

  @@index([tenantId, memberSubscriptionId, effectiveAt])
  @@index([tenantId, entryType, effectiveAt])
}

model EntitlementAdjustment {
  id                        String                    @id @default(cuid())
  tenantId                  String
  tenant                    Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberSubscriptionId      String
  memberSubscription        MemberSubscription        @relation(fields: [memberSubscriptionId], references: [id], onDelete: Restrict)
  subscriptionEntitlementId String
  subscriptionEntitlement   SubscriptionEntitlement   @relation(fields: [subscriptionEntitlementId], references: [id], onDelete: Restrict)
  kind                      EntitlementAdjustmentKind
  unitsDelta                Int                       @default(0)
  endDateDeltaSeconds       Int                       @default(0)
  previousRemainingUnits    Int?
  nextRemainingUnits        Int?
  previousStartDate         DateTime?
  nextStartDate             DateTime?
  previousEndDate           DateTime?
  nextEndDate               DateTime?
  reason                    String
  createdById               String?
  createdBy                 User?                     @relation("EntitlementAdjustmentActor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt                 DateTime                  @default(now())

  @@index([tenantId, memberSubscriptionId, createdAt])
  @@index([tenantId, subscriptionEntitlementId, createdAt])
}

model Payment {
  id                   String             @id @default(cuid())
  tenantId             String?
  tenant               Tenant?            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberSubscriptionId String
  memberSubscription   MemberSubscription @relation(fields: [memberSubscriptionId], references: [id], onDelete: Cascade)
  amount               Int
  entryType            PaymentEntryType   @default(PAYMENT)
  correctsPaymentId    String?
  correctionReason     String?
  createdById          String?
  paymentDate          DateTime           @default(now())
  paymentMethod        String?
  notes                String?
  receipt              Receipt?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([tenantId])
  @@index([tenantId, paymentDate])
  @@index([tenantId, memberSubscriptionId])
  @@index([correctsPaymentId])
  @@index([createdById])
}

model Receipt {
  id               String        @id @default(cuid())
  tenantId         String?
  tenant           Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  paymentId        String        @unique
  payment          Payment       @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  receiptNumber    String
  verificationCode String
  status           ReceiptStatus @default(ISSUED)
  issuedAt         DateTime      @default(now())
  issuedById       String?
  voidedAt         DateTime?
  voidReason       String?
  snapshotJson     String
  contentHash      String
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([tenantId, receiptNumber])
  @@index([tenantId])
  @@index([tenantId, issuedAt, status])
  @@index([verificationCode])
  @@index([issuedById])
}

model Offer {
  id                String             @id @default(cuid())
  tenantId          String?
  tenant            Tenant?            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name              String
  description       String?
  kind              OfferKind
  planScope         OfferPlanScope     @default(ALL)
  isActive          Boolean            @default(true)
  /// JSON snapshot kept in sync on write; structured columns are the source of truth.
  rules             String
  percentOff        Int?
  amountOffCents    Int?
  bundlePriceCents  Int?
  minMembers        Int?
  requiresHousehold Boolean?
  maxMembers        Int?
  sportId           String?
  sport             Sport?             @relation(fields: [sportId], references: [id], onDelete: SetNull)
  createdById       String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  applications      OfferApplication[]

  @@index([tenantId])
}

model OfferApplication {
  id              String               @id @default(cuid())
  tenantId        String?
  tenant          Tenant?              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  offerId         String
  offer           Offer                @relation(fields: [offerId], references: [id], onDelete: Restrict)
  memberIds       String
  subscriptionIds String
  quoteSnapshot   String
  createdById     String?
  createdAt       DateTime             @default(now())
  subscriptions   MemberSubscription[]

  @@index([tenantId])
}

model Attendance {
  id                        String                   @id @default(cuid())
  tenantId                  String?
  tenant                    Tenant?                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessionId                 String
  session                   Session                  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  memberId                  String
  member                    Member                   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberSubscriptionId      String?
  memberSubscription        MemberSubscription?      @relation(fields: [memberSubscriptionId], references: [id], onDelete: SetNull)
  subscriptionEntitlementId String?
  subscriptionEntitlement   SubscriptionEntitlement? @relation(fields: [subscriptionEntitlementId], references: [id], onDelete: SetNull)
  status                    AttendanceStatus
  overrideReason            String?
  checkedBy                 String?
  checkedAt                 DateTime                 @default(now())
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt

  @@unique([tenantId, sessionId, memberId])
  @@index([tenantId])
  @@index([subscriptionEntitlementId])
}

model TenantModule {
  id         String             @id @default(cuid())
  tenantId   String
  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  moduleKey  TenantModuleKey
  status     TenantModuleStatus @default(ENABLED)
  enabledAt  DateTime?
  disabledAt DateTime?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@unique([tenantId, moduleKey])
  @@index([tenantId, status])
}

model GymVisit {
  id                        String                  @id @default(cuid())
  tenantId                  String
  tenant                    Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberId                  String
  member                    Member                  @relation(fields: [memberId], references: [id], onDelete: Restrict)
  memberSubscriptionId      String
  memberSubscription        MemberSubscription      @relation(fields: [memberSubscriptionId], references: [id], onDelete: Restrict)
  subscriptionEntitlementId String
  subscriptionEntitlement   SubscriptionEntitlement @relation(fields: [subscriptionEntitlementId], references: [id], onDelete: Restrict)
  entryType                 GymVisitEntryType       @default(CHECK_IN)
  correctsVisitId           String?
  correctsVisit             GymVisit?               @relation("GymVisitCorrections", fields: [correctsVisitId], references: [id], onDelete: Restrict)
  corrections               GymVisit[]              @relation("GymVisitCorrections")
  unitsDelta                Int                     @default(0)
  checkedAt                 DateTime                @default(now())
  checkedById               String?
  checkedBy                 User?                   @relation("GymVisitCheckedBy", fields: [checkedById], references: [id], onDelete: SetNull)
  overrideReason            String?
  correctionReason          String?
  createdAt                 DateTime                @default(now())

  @@index([tenantId, checkedAt])
  @@index([memberId, checkedAt])
  @@index([subscriptionEntitlementId])
  @@index([correctsVisitId])
}

model MemberAccessCredential {
  id           String             @id
  tenantId     String
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberId     String
  member       Member             @relation(fields: [memberId], references: [id], onDelete: Restrict)
  codeHint     String
  issuedAt     DateTime           @default(now())
  issuedById   String?
  issuedBy     User?              @relation("GymCredentialIssuedBy", fields: [issuedById], references: [id], onDelete: SetNull)
  revokedAt    DateTime?
  revokedById  String?
  revokedBy    User?              @relation("GymCredentialRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)
  revokeReason String?
  attempts     GymAccessAttempt[]
  createdAt    DateTime           @default(now())

  @@index([tenantId, memberId, revokedAt])
  @@index([tenantId, issuedAt])
}

model GymAccessAttempt {
  id                    String                  @id @default(cuid())
  tenantId              String
  tenant                Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberId              String?
  member                Member?                 @relation(fields: [memberId], references: [id], onDelete: Restrict)
  credentialId          String?
  credential            MemberAccessCredential? @relation(fields: [credentialId], references: [id], onDelete: Restrict)
  outcome               GymAccessAttemptOutcome
  failureCode           String?
  identifierFingerprint String?
  overrideReason        String?
  checkedById           String?
  checkedBy             User?                   @relation("GymAccessAttemptActor", fields: [checkedById], references: [id], onDelete: SetNull)
  occurredAt            DateTime                @default(now())

  @@index([tenantId, occurredAt])
  @@index([tenantId, outcome, occurredAt])
  @@index([tenantId, memberId, occurredAt])
  @@index([credentialId])
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String?
  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  action     String
  entityType String
  entityId   String
  userId     String?
  details    String?
  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([tenantId, action, createdAt])
}
