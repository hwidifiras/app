# PostgreSQL is required for the multi-tenant SaaS app. Docker Compose uses
# these values to construct DATABASE_URL. Generate the password with:
# openssl rand -hex 32
POSTGRES_USER="gymday"
POSTGRES_PASSWORD="replace-with-strong-password"
POSTGRES_DB="gymday_prod"
# For a managed or non-Compose database, set its PostgreSQL connection URL:
# DATABASE_URL="postgresql://user:password@host:5432/database?schema=public"

AUTH_SECRET="replace-with-a-long-random-secret"
# Keep this value stable. Rotating it invalidates all issued gym access cards.
ACCESS_CREDENTIAL_SECRET="replace-with-a-different-long-random-secret"
APP_URL="https://your-domain.com"
APP_NAME="GymDay"
APP_TIMEZONE="Africa/Tunis"
SAAS_ROOT_DOMAIN="we-discipline.com"
DEFAULT_TENANT_SLUG="we-discipline"
ALLOW_PUBLIC_REGISTER="false"

# Owner signup runs on a dedicated platform host. Keep DISABLED through the
# first deployment, then use INVITE_ONLY before considering PUBLIC.
PLATFORM_APP_URL="https://app.we-discipline.com"
SAAS_PLATFORM_HOSTS="app.we-discipline.com"
SAAS_RESERVED_SLUGS="www,api,admin,billing,status"
SAAS_SIGNUP_MODE="DISABLED"
SAAS_SIGNUP_TRIAL_DAYS="14"
SAAS_SIGNUP_TRIAL_GRACE_DAYS="3"
SAAS_TERMS_URL="https://we-discipline.com/conditions"
SAAS_PRIVACY_URL="https://we-discipline.com/confidentialite"
SIGNUP_TOKEN_SECRET="replace-with-a-third-independent-long-random-secret"
# NONE is valid only while signup is disabled or invite-only. Public signup
# requires TURNSTILE or RECAPTCHA plus matching site and secret keys.
NEXT_PUBLIC_SIGNUP_ANTI_BOT_PROVIDER="NONE"
NEXT_PUBLIC_SIGNUP_ANTI_BOT_SITE_KEY=""
SIGNUP_ANTI_BOT_SECRET=""
SIGNUP_ANTI_BOT_ACTION="workspace_signup"
SIGNUP_RECAPTCHA_MIN_SCORE="0.5"

# Use redis for multiple app replicas. A single-replica VPS may explicitly use
# memory, but must switch to redis before horizontal scaling.
RATE_LIMIT_BACKEND="redis"
RATE_LIMIT_REDIS_REST_URL=""
RATE_LIMIT_REDIS_REST_TOKEN=""
RATE_LIMIT_KEY_PREFIX="gymday:rate-limit"
# Direct Nginx -> app deployment: trust exactly one proxy hop.
TRUSTED_PROXY_HOPS="1"

# Host port mapped to the production container.
HOST_PORT="3000"

# Leave both empty to disable email, or configure both with real values.
RESEND_API_KEY=""
PASSWORD_RESET_FROM=""
SAAS_SIGNUP_FROM=""
