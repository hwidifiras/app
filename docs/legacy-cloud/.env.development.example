# Dev fork - copy to .env.development. Never use this file for client VPS production.
# Next.js loads this automatically when you run: npm run dev

DATABASE_URL="postgresql://gymday:gymday@localhost:5432/gymday_dev?schema=public"
AUTH_SECRET="dev-only-secret-change-me-not-for-production"
ACCESS_CREDENTIAL_SECRET="dev-only-access-card-secret-change-me"
APP_TIMEZONE="Africa/Tunis"
APP_URL="http://localhost:3000"
APP_NAME="GymDay"
SAAS_ROOT_DOMAIN="localhost"
DEFAULT_TENANT_SLUG="we-discipline"
PLATFORM_APP_URL="http://app.localhost:3000"
SAAS_SIGNUP_MODE="DISABLED"
SAAS_SIGNUP_TRIAL_DAYS="14"
SAAS_SIGNUP_TRIAL_GRACE_DAYS="3"
SAAS_TERMS_URL=""
SAAS_PRIVACY_URL=""
SIGNUP_TOKEN_SECRET="dev-signup-secret-change-me-32-characters"
NEXT_PUBLIC_SIGNUP_ANTI_BOT_PROVIDER="NONE"
NEXT_PUBLIC_SIGNUP_ANTI_BOT_SITE_KEY=""
SIGNUP_ANTI_BOT_SECRET=""
# Keep false: accounts are created from Settings -> Users.
ALLOW_PUBLIC_REGISTER="false"

# Resend - replace re_xxxxxxxxx with your key from https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxx"
# Testing: use Resend sandbox sender; production: your verified domain.
PASSWORD_RESET_FROM="GymDay <onboarding@resend.dev>"
SAAS_SIGNUP_FROM="We Discipline <onboarding@resend.dev>"
