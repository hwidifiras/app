DATABASE_URL="postgresql://gymday:gymday@localhost:5432/gymday_dev?schema=public"
AUTH_SECRET="change-me-in-production"
# Optional in development. Set a stable, independent 32+ character value in production
# so existing gym access cards survive an AUTH_SECRET rotation.
ACCESS_CREDENTIAL_SECRET=""
APP_TIMEZONE="Africa/Tunis"
APP_URL="http://localhost:3000"
APP_NAME="GymDay"
SAAS_ROOT_DOMAIN="localhost"
DEFAULT_TENANT_SLUG="we-discipline"
# Platform routes such as owner signup and workspace recovery live outside any tenant.
PLATFORM_APP_URL="http://app.localhost:3000"
SAAS_PLATFORM_HOSTS=""
SAAS_RESERVED_SLUGS=""
# Keep disabled until email, wildcard DNS/TLS, rate limiting, and cloud QA are ready.
SAAS_SIGNUP_MODE="DISABLED"
SAAS_SIGNUP_TRIAL_DAYS="14"
# Independent signing key for signup sessions, verification links, invitations,
# request fingerprints, and one-time workspace handoff tokens.
SIGNUP_TOKEN_SECRET=""
# NONE, TURNSTILE, or RECAPTCHA. Provider verification is server-side.
NEXT_PUBLIC_SIGNUP_ANTI_BOT_PROVIDER="NONE"
NEXT_PUBLIC_SIGNUP_ANTI_BOT_SITE_KEY=""
SIGNUP_ANTI_BOT_SECRET=""
SIGNUP_ANTI_BOT_ACTION="workspace_signup"
SIGNUP_RECAPTCHA_MIN_SCORE="0.5"
RESEND_API_KEY="re_xxxxxxxxx"
PASSWORD_RESET_FROM="GymDay <onboarding@resend.dev>"
SAAS_SIGNUP_FROM="We Discipline <onboarding@resend.dev>"
