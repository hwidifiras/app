{
  "name": "all-in-gym-offline",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/offline-env.mjs",
    "dev": "node scripts/desktop.mjs dev",
    "dev:setup": "node scripts/download-mongodb.mjs",
    "build": "next build --webpack",
    "prestart": "node scripts/offline-env.mjs",
    "start": "node scripts/desktop.mjs dev",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/offline-env.mjs",
    "test": "node scripts/offline-test.mjs",
    "test:ui-contract": "vitest run tests/ui-system-contract.test.ts --config vitest.no-db.config.ts",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "handoff:check": "node scripts/offline-test.mjs",
    "lighthouse": "node scripts/lighthouse-audit.mjs",
    "audit:screen-reader": "node scripts/audit-screen-reader-semantics.mjs",
    "perf:check": "node scripts/perf-check.mjs",
    "perf:check:local": "node scripts/perf-check.mjs --with-server",
    "postinstall": "prisma generate",
    "desktop:dev": "node scripts/desktop.mjs dev",
    "desktop:package": "node scripts/desktop.mjs package",
    "desktop:installer": "node scripts/desktop.mjs installer",
    "offline:runtime": "node scripts/download-mongodb.mjs",
    "offline:import": "node scripts/offline-import.mjs",
    "offline:reset-password": "node scripts/offline-reset-password.mjs",
    "offline:provision-account": "node scripts/offline-provision-account.mjs",
    "test:runtime": "node --test tests/offline-runtime.node.mjs",
    "test:server": "node --test tests/offline-server.node.mjs",
    "test:desktop": "node scripts/offline-desktop-smoke.mjs",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report artifacts/playwright/report",
    "offline:export": "node scripts/export-offline-data.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@prisma/client": "6.19.3",
    "@zxing/browser": "0.1.5",
    "@zxing/library": "0.21.3",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "jose": "^6.1.0",
    "lucide-react": "0.468.0",
    "mongodb": "6.21.0",
    "next": "16.3.1",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "read-excel-file": "^9.2.0",
    "resend": "^4.8.0",
    "shadcn": "^4.5.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "write-excel-file": "4.1.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "lighthouse": "^12.8.2",
    "pg": "8.16.3",
    "playwright": "1.62.1",
    "prisma": "6.19.3",
    "tailwindcss": "^4",
    "tsx": "4.20.6",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "postcss": "8.5.26"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.16.0"
  }
